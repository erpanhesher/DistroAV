    .card small {
      display: block;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--muted);
      margin-bottom: 0.4rem;
    }

    .card p {
      font-size: 0.88rem;
      color: #d7d8e1;
    }

    .pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-top: 0.5rem;
    }

    .pill {
      font-size: 0.7rem;
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      color: var(--muted);
    }

    .list {
      list-style: none;
      font-size: 0.9rem;
      color: #d9dae4;
    }

    .list li {
      margin-bottom: 0.45rem;
    }

    .list strong {
      color: var(--accent);
