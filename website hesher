      font-weight: 500;
    }

    .panel-text {
      font-size: 0.85rem;
      color: var(--muted);
    }

    .panel-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 0.4rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem 0.9rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      background: rgba(5,6,10,0.9);
      color: var(--text);
      cursor: pointer;
    }

    .btn.primary {
      border-color: var(--accent);
      background: var(--accent-soft);
      color: var(--accent);
    }

    .btn:hover {
      text-decoration: none;
      border-color: var(--accent);
    }

    h2.section-title {
      font-size: 1.1rem;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--muted);
      margin-bottom: 1.2rem;
    }

    .two-col {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 2rem;
      align-items: flex-start;
    }

    .body-text {
      font-size: 0.95rem;
      color: #e0e1ea;
    }

    .muted {
      color: var(--muted);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1.3rem;
    }

    .card {
      border-radius: 1.1rem;
      border: 1px solid var(--border);
      padding: 1rem 1.1rem 1.1rem;
      background: linear-gradient(145deg, rgba(12,14,20,0.98), rgba(5,6,10,0.96));
