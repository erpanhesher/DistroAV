<head>
  <meta charset="UTF-8">
  <title>Erpan Hesher – Electronic Musician & Sound Artist</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Official website of Erpan Hesher – Uyghur electronic musician, sound artist and composer based in France. AV performances, cine-concerts, soundtracks and interdisciplinary projects.">
  <style>
    :root {
      --bg: #05060a;
      --bg-alt: #0c0f16;
      --accent: #f4c66b;
      --accent-soft: rgba(244,198,107,0.12);
      --text: #f5f5f5;
      --muted: #a6a7b0;
      --border: #232531;
      --font-main: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --max-width: 1100px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: radial-gradient(circle at top, #111525 0, #05060a 55%);
      color: var(--text);
      font-family: var(--font-main);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: var(--accent);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    header {
      width: 100%;
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(16px);
      background: linear-gradient(to bottom, rgba(5,6,10,0.9), rgba(5,6,10,0.6));
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0.8rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .logo {
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-size: 0.9rem;
      color: var(--accent);
    }

    nav a {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--muted);
      margin-left: 1.5rem;
      white-space: nowrap;
    }

    nav a:hover {
      color: var(--accent);
      text-decoration: none;
    }

    main {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 2.5rem 1.25rem 3.5rem;
    }

    section {
      margin-bottom: 3.5rem;
    }

    .hero {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 2rem;
      align-items: center;
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .hero-title {
      font-size: clamp(2.2rem, 4vw, 3rem);
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 0.6rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
      color: var(--muted);
      max-width: 26rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
    }

    .hero-body {
      margin-top: 1.2rem;
      font-size: 0.98rem;
      color: #e3e3ea;
      max-width: 34rem;
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.4rem;
    }

    .tag {
      border-radius: 999px;
      border: 1px solid var(--border);
      font-size: 0.75rem;
      padding: 0.35rem 0.8rem;
      color: var(--muted);
      background: rgba(10,12,18,0.8);
    }

    .hero-right {
      border-radius: 1.5rem;
      border: 1px solid var(--border);
      background: radial-gradient(circle at top left, rgba(244,198,107,0.14), transparent 55%),
                  linear-gradient(135deg, #090b12, #05060a);
      padding: 1.4rem 1.4rem 1.6rem;
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .panel-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--muted);
      margin-bottom: 0.15rem;
    }

    .panel-title {
